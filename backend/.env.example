# 本地环境变量样例(复制为 backend/.env.local 后填值;.env.local 已被 .gitignore 排除)
#
# Spring Boot 不会自动读取 .env 文件,必须在启动前导出为真实环境变量:
#   Git Bash:  cd backend && set -a && . ./.env.local && set +a && ./mvnw.cmd spring-boot:run
#   PowerShell: cd backend; Get-Content .env.local | ForEach-Object { if ($_ -match '^[^#]') { $k,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($k,$v) } }; .\mvnw.cmd spring-boot:run
#   VSCode:     在 .vscode/launch.json 的后端配置里加 "envFile": "${workspaceFolder}/backend/.env.local"
#
# 未设置时应用仍会启动(使用 application.yml 内置默认值),但启动日志会逐项 WARN。

# ===== AI(Spring AI OpenAI 兼容端点)=====
# 不配置时四个 AI 入口(AI 出题、作文 AI 评分、无答案客观题 AI 判分、模考异步评分)都会失败并走降级分支。
LC_AI_API_KEY=
# DeepSeek 官方:https://api.deepseek.com(其 /chat/completions 与 /v1/chat/completions 两条路径均可用,
# 因此无需覆盖 completions-path;若换成只挂其中一条的网关,需另加 spring.ai.openai.chat.completions-path)
LC_AI_BASE_URL=https://api.deepseek.com
# 模型名会写入题目的 source.meta.model
LC_AI_MODEL=deepseek-chat

# ===== 安全与数据源(对外环境必须显式注入)=====
LC_JWT_SECRET=
LC_DB_USERNAME=root
LC_DB_PASSWORD=
